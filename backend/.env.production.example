# Enter these values in Render Environment, rather than committing a .env file.
APP_ENV=production
API_PREFIX=
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://YOUR_PROJECT.vercel.app
DEMO_MODE=true
SERPAPI_API_KEY=
LOG_LEVEL=INFO
